# Postgres Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=SeatHunterDb

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=2051304885

# JWT Configuration
JWT_KEY=your_super_secret_jwt_key_here

# Email Configuration
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Scraper & Proxy Configuration (Optional, comma-separated e.g. http://user:pass@proxy.example.com:8080)
SCRAPER_PROXIES=

# Discord Webhook Configuration (Optional, for instant rich embed notifications)
DISCORD_WEBHOOK_URL=
